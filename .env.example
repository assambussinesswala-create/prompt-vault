# Copy this file to .env.local for local development.
# In production, add the SAME names in Vercel -> Project -> Settings -> Environment Variables.
# NEVER put real values in this file and never commit .env.local.

# --- Sign-in (Clerk: https://clerk.com) ---
# Public by design. It is safe in the browser.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# SECRET. Server only. Never prefix with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me

# --- Database (Neon Postgres: https://neon.tech or the Vercel Marketplace) ---
# SECRET. Server only.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- Password encryption ---
# SECRET. Server only. Must be Base64 that decodes to EXACTLY 32 bytes.
# Create one with:  npm run generate-key
# BACK IT UP somewhere safe. If it is lost, saved passwords can never be decrypted.
VAULT_ENCRYPTION_KEY=replace_with_output_of_npm_run_generate_key
