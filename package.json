{
  "name": "prompt-vault",
  "private": true,
  "version": "2.0.0",
  "description": "Prompt Vault PK - links, encrypted passwords and AI prompts in one secure vault.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:vercel": "vite build",
    "preview": "vite preview",
    "test": "vitest run && npm run test:api",
    "test:api": "node --test test/api.test.mjs",
    "typecheck": "tsc -b --noEmit",
    "generate-key": "node scripts/generate-key.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@clerk/backend": "^1.0.0",
    "@clerk/clerk-react": "^5.0.0",
    "@neondatabase/serverless": "^0.10.4",
    "lucide-react": "^0.453.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
